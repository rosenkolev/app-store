{
  "$schema": "https://schemas.runtipi.io/dynamic-compose.json",
  "services": [
    {
      "name": "bluetooth-to-speaker",
      "image": "ghcr.io/rosenkolev/bluetooth-to-speaker:0.1.0",
      "isMain": true,
      "internalPort": 8780,
      "networkMode": "host",
      "devices": ["/dev/snd:/dev/snd"],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data", "containerPath": "/data" },
        { "hostPath": "/run/dbus", "containerPath": "/run/dbus", "readOnly": true }
      ],
      "capDrop": ["ALL"],
      "capAdd": ["SYS_NICE"],
      "readOnly": true,
      "securityOpt": ["no-new-privileges:true"],
      "environment": [
        { "key": "BT_NAME", "value": "${BT_NAME}" },
        { "key": "HTTP_PORT", "value": "${APP_PORT}" }
      ]
    }
  ]
}
